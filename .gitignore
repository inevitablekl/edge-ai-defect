# Keep curated JSON configuration files trackable.
!configs/**/*.json
!experiments/configs/**/*.json

# Track lightweight training result summaries.
!results/training/*.csv
!results/training/*.json
!results/training/evidence/**/
!results/training/evidence/**/*.json
!results/training/evidence/**/*.csv
!results/training/evidence/**/*.yaml
!results/training/evidence/**/*.txt

# Evaluation outputs are local-only; curated summaries live under results/.
predictions.json

# Archive artifacts (local only, not committed).
artifacts/transfer/

# Local third-party dependency payloads
/third_party/downloads/*
!/third_party/downloads/.gitkeep
/third_party/onnxruntime/1.23.2/linux-x64/
/third_party/onnxruntime/1.23.2/linux-aarch64/include/
/third_party/onnxruntime/1.23.2/linux-aarch64/lib/

# Raw TensorRT and diagnostic tensor artifacts; formal reports/manifests remain trackable.
*.f32le
*.engine
**/debug_dump/
**/debug_tensors/

# Retained local Stage K supplemental attempts; curated official summaries remain trackable.
/results/validation/stage_k6/stability_smoke/
/results/validation/stage_k6/stability_smoke2/
/results/validation/stage_k6/stability_smoke3/
/results/validation/stage_k_task_eval_v2/ground_truth_audit/

# Diagnostic archive payload is retained locally; its tracked manifest is the Git index.
/results/archive/stage_k_diagnostics_v1/**
!/results/archive/stage_k_diagnostics_v1/
!/results/archive/stage_k_diagnostics_v1/archive_manifest.json

# Stage Q local-only raw evidence; curated reports, manifests, summaries, and
# reproducibility hash metadata remain trackable.
/results/validation/stage_q/**/*_result.json
/results/validation/stage_q/**/*_sidecar.json
/results/validation/stage_q/**/environment_*.txt
/results/validation/stage_q/**/tegrastats.txt
/results/benchmark/stage_q/**/*_sidecar.json
/results/benchmark/stage_q/**/environment_*.txt
